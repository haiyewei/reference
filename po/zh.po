"        //!\n"
msgstr ""
"// empty inner line doc\n"
"        //!\n"

#: src/comments.md:926
msgid ""
"// empty inner block doc\n"
"        /*!*/"
msgstr ""
"// empty inner block doc\n"
"        /*!*/"

#: src/comments.md:929
