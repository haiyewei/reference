msgstr "r\\[attributes.meta.builtin.syntax\\]"

#: src/attributes.md:163
msgid "Some examples of meta items are:"
msgstr "元项的一些示例如下："

#: src/attributes.md:165
msgid "Style"
msgstr "样式"

