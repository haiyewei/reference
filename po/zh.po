#: src/tokens.md:344
msgid ""
"```grammar,lexer\n"
"C_STRING_LITERAL ->\n"
"    `c\"` ^ (\n"
"        ~[`\"` `\\` CR NUL]\n"
"      | BYTE_ESCAPE _except `\\0` or `\\x00`_\n"
"      | UNICODE_ESCAPE _except `\\u{0}`, `\\u{00}`, …, `\\u{000000}`_\n"
"      | STRING_CONTINUE\n"
"    )* `\"` SUFFIX?\n"
"```"
msgstr ""
