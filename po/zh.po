msgid "\"Quit\""
msgstr "\"Quit\""

#: src/patterns.md:414
msgid "\"move {} horizontally\""
msgstr "\"move {} horizontally\""

#: src/patterns.md:415
msgid "\"other move\""
msgstr "\"other move\""

