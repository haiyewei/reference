msgid "[Built-in types](../types.md)"
msgstr "[内置类型](../types.md)"

#: src/items/use-declarations.md:99
msgid "[Attributes](../attributes.md)"
msgstr "[属性](../attributes.md)"

#: src/items/use-declarations.md:100 src/names/namespaces.md:41
