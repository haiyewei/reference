#: src/tokens.md:468
msgid ""
"r\\[lex.token.literal.int.kind\\] An _integer literal_ has one of four forms:"
msgstr "r\\[lex.token.literal.int.kind\\] *整数字面量*有四种形式之一："

#: src/tokens.md:471
