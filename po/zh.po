msgid "r\\[lex.token.str-byte.escape-null\\]"
msgstr "r\\[lex.token.str-byte.escape-null\\]"

#: src/tokens.md:295
msgid ""
"The _null escape_ is the character `U+0030` (`0`) and denotes the byte value "
"`0x00` (ASCII NUL)."
msgstr "*空值转义*是字符 `U+0030`（`0`），表示字节值 `0x00`（ASCII NUL）。"

