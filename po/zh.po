msgstr "`\"openbsd\"`"

#: src/conditional-compilation.md:591
msgid "`\"netbsd\"`"
msgstr "`\"netbsd\"`"

#: src/conditional-compilation.md:592
msgid "`\"none\"` (typical for embedded targets)"
msgstr "`\"none\"`（嵌入式目标的典型值）"

