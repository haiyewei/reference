msgid "`(\"x\".to_string(), )`"
msgstr "`(\"x\".to_string(), )`"

#: src/expressions/tuple-expr.md:164
msgid "`(String, )`"
msgstr "`(String, )`"

#: src/expressions/tuple-expr.md:165
msgid "`(\"a\", 4usize, true)`"
msgstr "`(\"a\", 4usize, true)`"

#: src/expressions/tuple-expr.md:165
msgid "`(&'static str, usize, bool)`"
msgstr "`(&'static str, usize, bool)`"

