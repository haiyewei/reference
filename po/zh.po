msgstr "`doc = \"example\"`"

#: src/attributes.md:169
msgid "\\[MetaListPaths\\]"
msgstr "\\[MetaListPaths\\]"

#: src/attributes.md:169
msgid "`allow(unused, clippy::inline_always)`"
msgstr "`allow(unused, clippy::inline_always)`"

#: src/attributes.md:170
msgid "\\[MetaListIdents\\]"
msgstr "\\[MetaListIdents\\]"

#: src/attributes.md:170
