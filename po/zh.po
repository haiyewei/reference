msgstr "// crate root 中的模块。\n"

#: src/names/name-resolution.md:62
msgid "// Expansion of `f` introduces a second `m` module inside this\n"
msgstr "// `f` 的展开会引入第二个 `m` 模块，位于这个\n"

#: src/names/name-resolution.md:63
msgid "// body.\n"
msgstr "// 主体内部。\n"

#: src/names/name-resolution.md:65
msgid "// Expansion-time resolution finalizes resolutions by re-\n"
msgstr "// 展开时解析会通过重新\n"

#: src/names/name-resolution.md:66
msgid "// resolving all imports and macro invocations, sees the\n"
msgstr "// 解析所有导入和宏调用，发现\n"

#: src/names/name-resolution.md:67
msgid "// introduced ambiguity and reports it as an error.\n"
msgstr "// 被引入的歧义，并将其报告为错误。\n"

