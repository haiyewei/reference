"// `start` is a slice of everything except the last element, which must be "
"\"z\".\n"
msgstr ""
"// `start` 是除最后一个元素之外所有内容的切片，而最后一个元素必须是 \"z\"。\n"

#: src/patterns.md:440
msgid "\"z\""
msgstr "\"z\""

