msgstr "\"mov {}, {}\""

#: src/inline-assembly.md:162
msgid "// ... this\n"
msgstr "// ... 这个\n"

#: src/inline-assembly.md:164
msgid "\"mov {0}, {1}\""
msgstr "\"mov {0}, {1}\""

#: src/inline-assembly.md:164
msgid "// ... and this\n"
msgstr "// ... 以及这个\n"

#: src/inline-assembly.md:166
msgid "\"mov {out}, {in}\""
msgstr "\"mov {out}, {in}\""

#: src/inline-assembly.md:166
msgid "// all have the same behavior\n"
msgstr "// 都具有相同的行为\n"

#: src/inline-assembly.md:173
msgid ""
"r\\[asm.ts-args.no-implicit\\] However, implicit named arguments (introduced "
"by [RFC #2795](https://github.com/rust-lang/rfcs/pull/2795)) are not "
"supported."
msgstr ""
"r\\[asm.ts-args.no-implicit\\] 但是，不支持隐式命名参数（由 [RFC #2795]"
"(https://github.com/rust-lang/rfcs/pull/2795) 引入）。"

#: src/inline-assembly.md:178
msgid ""
"// We can't refer to `x` from the scope directly, we need an operand like "
"`in(reg) x`\n"
msgstr "// 不能直接引用作用域中的 `x`，需要像 `in(reg) x` 这样的操作数\n"

#: src/inline-assembly.md:180 src/inline-assembly.md:205
msgid "\"/* {x} */\""
msgstr "\"/* {x} */\""

#: src/inline-assembly.md:180
msgid "// ERROR: no argument named x\n"
msgstr "// ERROR: no argument named x\n"

#: src/inline-assembly.md:182 src/inline-assembly.md:207
#: src/inline-assembly.md:219 src/inline-assembly.md:228
#: src/inline-assembly.md:240 src/inline-assembly.md:252
