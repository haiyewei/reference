"// 这里匹配第一个子模式，丢弃按照第一个子模式中的\n"
"// 声明顺序发生。\n"

#: src/destructors.md:246 src/destructors.md:254
msgid "\"Declared first, dropped last\""
msgstr "\"先声明，后丢弃\""

#: src/destructors.md:247 src/destructors.md:253
msgid "\"Declared last, dropped first\""
msgstr "\"后声明，先丢弃\""

#: src/destructors.md:249
