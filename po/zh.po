msgstr "2018"

#: src/names/preludes.md:30
msgid "\\[`std::prelude::rust_2018`\\]"
msgstr "\\[`std::prelude::rust_2018`\\]"

#: src/names/preludes.md:30
msgid "\\[`core::prelude::rust_2018`\\]"
msgstr "\\[`core::prelude::rust_2018`\\]"

#: src/names/preludes.md:31
